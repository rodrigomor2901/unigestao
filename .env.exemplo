# ============================================================================
# UniGestao — variaveis de ambiente
# Copie para .env (local) ou configure no painel do Railway (producao).
# ============================================================================

# --- CORE -------------------------------------------------------------------
DATABASE_URL=postgres://postgres:teste@localhost:55987/unigestao
PORT=3000
NODE_ENV=development

# Chave compartilhada entre Core, Fachada e modulos.
# Em producao: gerar com  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORE_INTERNAL_KEY=troque-esta-chave-em-producao

# Duracao da sessao, em horas
SESSAO_HORAS=10

# Primeiro super admin — criado apenas se o banco estiver vazio.
# Se BOOTSTRAP_SENHA nao for informada, uma senha aleatoria e impressa no log.
BOOTSTRAP_NOME=Rodrigo Moraes
BOOTSTRAP_EMAIL=rodrigo.moraes@uniseter.com
# BOOTSTRAP_SENHA=

# --- FACHADA ----------------------------------------------------------------
# Endereco do Core na rede privada do Railway
URL_CORE=http://localhost:3000

# Endereco de cada modulo na rede privada. Deixe em branco enquanto o modulo
# nao estiver conectado — ele aparece como "ainda nao conectado".
# Em producao ficam assim: http://nome-do-servico.railway.internal:PORTA
URL_OPERACIONAL=
URL_DOCUMENTOS=
URL_EVENTOS=
URL_TAREFAS=
URL_CRM=
URL_PRECIFICACAO=
